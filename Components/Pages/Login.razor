@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Вход</PageTitle>

<h1>Вход</h1>

<div style="max-width: 400px">
    @if (error != "")
    {
        <div class="alert alert-danger">@error</div>
    }

    <label>Email</label>
    <input class="form-control" type="email" @bind="email" @bind:event="oninput" />

    <label class="mt-2">Пароль</label>
    <input class="form-control" type="password" @bind="password" @bind:event="oninput" @onkeydown="OnKeyDown" />

    <button class="btn btn-primary mt-3" @onclick="DoLogin">Войти</button>
</div>

@code {
    string email = "";
    string password = "";
    string error = "";

    async Task DoLogin()
    {
        error = "";

        var result = await Auth.LoginAsync(email, password);

        if (result == null)
        {
            // вход выполнен, переходим на главную страницу
            Nav.NavigateTo("/");
        }
        else
        {
            error = result;
        }
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DoLogin();
        }
    }
}