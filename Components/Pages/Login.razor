@page "/login"
@inject RentalFacade Facade
@inject NavigationManager Nav

<PageTitle>Вход</PageTitle>

<div class="form-box">
    <h1>Вход</h1>

    @if (error != "")
    {
        <div class="message message-error">@error</div>
    }

    <label>Email</label>
    <input class="field" type="email" @bind="email" @bind:event="oninput" />

    <label>Пароль</label>
    <input class="field" type="password" @bind="password" @bind:event="oninput" @onkeydown="OnKeyDown" />

    <button class="button button-olive" @onclick="DoLogin">Войти</button>

    <p class="small">Нет аккаунта? <a href="register">Зарегистрируйтесь</a></p>
</div>

@code {
    string email = "";
    string password = "";
    string error = "";

    async Task DoLogin()
    {
        var result = await Facade.LoginAsync(email, password);

        if (result == null)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            error = result;
        }
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DoLogin();
        }
    }
}