@page "/admin"
@inject RentalFacade Facade

<PageTitle>Админ-панель</PageTitle>

@if (!Facade.IsAdmin)
{
    <p>Эта страница только для администратора. <a href="login">Войти</a></p>
}
else
{
    <h1>Админ-панель</h1>

    @if (message != "")
    {
        <div class="message @(isError ? "message-error" : "message-ok")">@message</div>
    }

    <h2>Бронирования</h2>

    @if (bookings.Count == 0)
    {
        <p>Броней пока нет.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-main">
                <thead>
                    <tr>
                        <th>Клиент</th>
                        <th>Инвентарь</th>
                        <th>Даты</th>
                        <th>Стоимость</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in bookings)
                    {
                        <tr>
                            <td>@b.User?.FullName</td>
                            <td>@b.Equipment?.Name</td>
                            <td>@b.StartDate.ToString("dd.MM.yyyy") - @b.EndDate.ToString("dd.MM.yyyy")</td>
                            <td>@b.TotalPrice.ToString("0") ₽</td>
                            <td><span class="badge @StatusClass(b.Status)">@b.Status</span></td>
                            <td>
                                @if (b.Status == "Новая")
                                {
                                    <button class="button button-olive button-small" @onclick="() => Confirm(b.Id)">Подтвердить</button>
                                }
                                else if (b.Status == "Подтверждена")
                                {
                                    <button class="button button-orange button-small" @onclick="() => Return(b.Id)">Отметить возврат</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>Инвентарь</h2>

    <div class="form-inline">
        <h3>@(editId == 0 ? "Добавить новый инвентарь" : "Изменить инвентарь")</h3>

        <label>Название</label>
        <input class="field" type="text" @bind="formName" />

        <label>Описание</label>
        <input class="field" type="text" @bind="formDescription" />

        <label>Цена за день, ₽</label>
        <input class="field" type="number" @bind="formPrice" />

        <label>Категория</label>
        <select class="field" @bind="formCategoryId">
            @foreach (var c in categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>

        <div class="actions">
            <button class="button button-olive" @onclick="SaveItem">@(editId == 0 ? "Добавить" : "Сохранить")</button>
            @if (editId != 0)
            {
                <button class="button button-rose" @onclick="CancelEdit">Отмена</button>
            }
        </div>
    </div>

    <div class="table-wrap">
        <table class="table-main">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Категория</th>
                    <th>Цена за день</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.PricePerDay.ToString("0") ₽</td>
                        <td>
                            <div class="actions">
                                <button class="button button-orange button-small" @onclick="() => Edit(item)">Изменить</button>
                                
                                <button class="button button-rose button-small" @onclick="() => Delete(item.Id)">Удалить</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    List<Booking> bookings = new();
    List<Equipment> items = new();
    List<Category> categories = new();

    // поля формы; editId = 0 значит "добавляем новый", иначе правим существующий
    int editId = 0;
    string formName = "";
    string formDescription = "";
    decimal formPrice = 0;
    int formCategoryId = 0;

    string message = "";
    bool isError = false;

    protected override async Task OnInitializedAsync()
    {
        if (!Facade.IsAdmin)
        {
            return;
        }

        await LoadAll();

        if (categories.Count > 0)
        {
            formCategoryId = categories[0].Id;
        }
    }

    async Task LoadAll()
    {
        bookings = await Facade.GetAllBookingsAsync();
        items = await Facade.GetEquipmentAsync(null);
        categories = await Facade.GetCategoriesAsync();
    }

    async Task ShowResult(string? error, string okText)
    {
        if (error == null)
        {
            message = okText;
            isError = false;
        }
        else
        {
            message = error;
            isError = true;
        }

        await LoadAll();
    }

    async Task Confirm(int id)
    {
        await ShowResult(await Facade.ConfirmBookingAsync(id), "Бронь подтверждена");
    }

    async Task Return(int id)
    {
        await ShowResult(await Facade.ReturnBookingAsync(id), "Возврат отмечен");
    }

    // кнопка "Изменить": кладём данные позиции в форму
    void Edit(Equipment item)
    {
        editId = item.Id;
        formName = item.Name;
        formDescription = item.Description;
        formPrice = item.PricePerDay;
        formCategoryId = item.CategoryId;
        message = "";
    }

    void CancelEdit()
    {
        ClearForm();
    }

    void ClearForm()
    {
        editId = 0;
        formName = "";
        formDescription = "";
        formPrice = 0;

        if (categories.Count > 0)
        {
            formCategoryId = categories[0].Id;
        }
    }

    async Task SaveItem()
    {
        string? error;
        string okText;

        if (editId == 0)
        {
            error = await Facade.AddEquipmentAsync(formName, formDescription, formPrice, formCategoryId);
            okText = "Инвентарь добавлен";
        }
        else
        {
            error = await Facade.UpdateEquipmentAsync(editId, formName, formDescription, formPrice, formCategoryId);
            okText = "Изменения сохранены";
        }

        if (error == null)
        {
            ClearForm();
        }

        await ShowResult(error, okText);
    }

    async Task Delete(int id)
    {
        if (editId == id)
        {
            ClearForm();
        }

        await ShowResult(await Facade.DeleteEquipmentAsync(id), "Инвентарь удалён");
    }

    string StatusClass(string status)
    {
        if (status == "Новая") return "badge-new";
        if (status == "Подтверждена") return "badge-ok";
        if (status == "Возвращена") return "badge-done";
        return "badge-cancel";
    }
}