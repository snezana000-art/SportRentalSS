@page "/catalog"
@inject RentalFacade Facade
@inject NavigationManager Nav

<PageTitle>Каталог</PageTitle>

<h1>Каталог инвентаря</h1>

<div class="filter">
    <label>Категория:</label>
    <select class="field" @onchange="OnCategoryChanged">
        <option value="0">Все категории</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id">@c.Name</option>
        }
    </select>
</div>

@if (message != "")
{
    <div class="message @(isError ? "message-error" : "message-ok")">@message</div>
}

<div class="grid">
    @foreach (var item in items)
    {
        <div class="card">
            <span class="tag">@item.Category?.Name</span>
            <h3>@item.Name</h3>
            <p>@item.Description</p>
            <div class="price">@item.PricePerDay.ToString("0") ₽ в день</div>

            <button class="button button-orange" @onclick="() => OpenBooking(item)">Забронировать</button>

            @if (selected != null && selected.Id == item.Id)
            {
                <div class="booking-form">
                    <label>С какого числа</label>
                    <input class="field" type="date" @bind="startDate" />

                    <label>По какое число</label>
                    <input class="field" type="date" @bind="endDate" />

                    @if (Days >= 1)
                    {
                        <p>Дней: @Days, итого: <b>@Total.ToString("0") ₽</b></p>
                    }
                    else
                    {
                        <p>Проверьте даты</p>
                    }

                    <button class="button button-olive" @onclick="Book">Подтвердить бронь</button>
                </div>
            }
        </div>
    }
</div>

@if (items.Count == 0)
{
    <p>В этой категории пока ничего нет.</p>
}

@code {
    List<Category> categories = new();
    List<Equipment> items = new();
    int categoryId = 0;

    Equipment? selected;
    DateTime startDate = DateTime.Today;
    DateTime endDate = DateTime.Today;

    string message = "";
    bool isError = false;

    int Days => (endDate.Date - startDate.Date).Days + 1;

    decimal Total => selected == null ? 0 : selected.PricePerDay * Days;

    protected override async Task OnInitializedAsync()
    {
        categories = await Facade.GetCategoriesAsync();
        await LoadItems();
    }

    async Task LoadItems()
    {
        items = await Facade.GetEquipmentAsync(categoryId == 0 ? null : categoryId);
    }

    async Task OnCategoryChanged(ChangeEventArgs e)
    {
        categoryId = int.Parse(e.Value?.ToString() ?? "0");
        selected = null;
        message = "";
        await LoadItems();
    }

    void OpenBooking(Equipment item)
    {
        message = "";

        if (!Facade.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        selected = item;
        startDate = DateTime.Today;
        endDate = DateTime.Today;
    }

    async Task Book()
    {
        if (selected == null)
        {
            return;
        }

        var error = await Facade.BookAsync(selected.Id, startDate, endDate);

        if (error == null)
        {
            message = "Бронь создана. Её можно посмотреть в личном кабинете.";
            isError = false;
            selected = null;
        }
        else
        {
            message = error;
            isError = true;
        }
    }
}