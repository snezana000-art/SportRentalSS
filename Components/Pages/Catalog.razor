@page "/catalog"
@inject RentalFacade Facade
@inject NavigationManager Nav

<PageTitle>Каталог</PageTitle>

<h1>Каталог инвентаря</h1>

<div class="mb-3" style="max-width: 300px">
    <label>Категория</label>
    <select class="form-select" @onchange="OnCategoryChanged">
        <option value="0">Все категории</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id">@c.Name</option>
        }
    </select>
</div>

@if (message != "")
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">
        @message
        @if (!isError)
        {
            <a href="cabinet">Перейти в личный кабинет</a>
        }
    </div>
}

<div class="row">
    @foreach (var item in items)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge bg-secondary">@item.Category?.Name</span>
                    <h5 class="card-title mt-2">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p><b>@item.PricePerDay.ToString("0") ₽ в день</b></p>

                    <button class="btn btn-primary" @onclick="() => OpenBooking(item)">Забронировать</button>

                    @if (selected != null && selected.Id == item.Id)
                    {
                        <div class="border rounded p-2 mt-3">
                            <label>С какого числа</label>
                            <input class="form-control" type="date" @bind="startDate" />

                            <label class="mt-2">По какое число</label>
                            <input class="form-control" type="date" @bind="endDate" />

                            @if (Days >= 1)
                            {
                                <p class="mt-2">Дней: @Days, итого: <b>@Total.ToString("0") ₽</b></p>
                            }
                            else
                            {
                                <p class="mt-2">Проверьте даты</p>
                            }

                            <button class="btn btn-success" @onclick="Book">Подтвердить бронь</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (items.Count == 0)
{
    <p>В этой категории пока ничего нет.</p>
}

@code {
    List<Category> categories = new();
    List<Equipment> items = new();
    int categoryId = 0;

    Equipment? selected;
    DateTime startDate = DateTime.Today;
    DateTime endDate = DateTime.Today;

    string message = "";
    bool isError = false;

    int Days => (endDate.Date - startDate.Date).Days + 1;

    decimal Total => selected == null ? 0 : selected.PricePerDay * Days;

    protected override async Task OnInitializedAsync()
    {
        categories = await Facade.GetCategoriesAsync();
        await LoadItems();
    }

    async Task LoadItems()
    {
        items = await Facade.GetEquipmentAsync(categoryId == 0 ? null : categoryId);
    }

    async Task OnCategoryChanged(ChangeEventArgs e)
    {
        categoryId = int.Parse(e.Value?.ToString() ?? "0");
        selected = null;
        message = "";
        await LoadItems();
    }
    void OpenBooking(Equipment item)
    {
        message = "";

        if (!Facade.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        selected = item;
        startDate = DateTime.Today;
        endDate = DateTime.Today;
    }

    async Task Book()
    {
        if (selected == null)
        {
            return;
        }
var error = await Facade.BookAsync(selected.Id, startDate, endDate);

        if (error == null)
        {
            message = "Бронь создана.";
            isError = false;
            selected = null;
        }
        else
        {
            message = error;
            isError = true;
        }
    }
}