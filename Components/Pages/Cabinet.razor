@page "/cabinet"
@inject RentalFacade Facade

<PageTitle>Личный кабинет</PageTitle>

@if (!Facade.IsLoggedIn)
{
    <p>Чтобы увидеть свои брони, <a href="login">войдите в аккаунт</a>.</p>
}
else
{
    <h1>Личный кабинет</h1>
    <p>Здравствуйте, @Facade.UserName!</p>

    @if (message != "")
    {
        <div class="message @(isError ? "message-error" : "message-ok")">@message</div>
    }

    <h2>Текущие брони</h2>

    @if (current.Count == 0)
    {
        <p>Текущих броней нет. <a href="catalog">Выбрать инвентарь</a></p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-main">
                <thead>
                    <tr>
                        <th>Инвентарь</th>
                        <th>Даты</th>
                        <th>Стоимость</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in current)
                    {
                        <tr>
                            <td>@b.Equipment?.Name</td>
                            <td>@b.StartDate.ToString("dd.MM.yyyy") - @b.EndDate.ToString("dd.MM.yyyy")</td>
                            <td>@b.TotalPrice.ToString("0") ₽</td>
                            <td><span class="badge @StatusClass(b.Status)">@b.Status</span></td>
                            <td><button class="button button-rose button-small" @onclick="() => Cancel(b.Id)">Отменить</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>Прошлые брони</h2>

    @if (past.Count == 0)
    {
        <p>Прошлых броней пока нет.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-main">
                <thead>
                    <tr>
                        <th>Инвентарь</th>
                        <th>Даты</th>
                        <th>Стоимость</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in past)
                    {
                        <tr>
                            <td>@b.Equipment?.Name</td>
                            <td>@b.StartDate.ToString("dd.MM.yyyy") - @b.EndDate.ToString("dd.MM.yyyy")</td>
                            <td>@b.TotalPrice.ToString("0") ₽</td>
                            <td><span class="badge @StatusClass(b.Status)">@b.Status</span></td>
                            <td>
                                @if (b.Status == "Отменена")
                                {
                                    <button class="button button-olive button-small" @onclick="() => Undo(b.Id)">Вернуть бронь</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    List<Booking> current = new();
    List<Booking> past = new();
    string message = "";
    bool isError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    async Task LoadBookings()
    {
        var all = await Facade.GetMyBookingsAsync();

        current = all.Where(b => b.Status == "Новая" || b.Status == "Подтверждена").ToList();
        past = all.Where(b => b.Status == "Возвращена" || b.Status == "Отменена").ToList();
    }

    async Task Cancel(int id)
    {
        var error = await Facade.CancelBookingAsync(id);
        ShowResult(error, "Бронь отменена. Если это ошибка, её можно вернуть в списке прошлых броней.");
        await LoadBookings();
    }

    async Task Undo(int id)
    {
        var error = await Facade.UndoCancelAsync(id);
        ShowResult(error, "Бронь возвращена.");
        await LoadBookings();
    }

    void ShowResult(string? error, string okText)
    {
if (error == null)
        {
            message = okText;
            isError = false;
        }
        else
        {
            message = error;
            isError = true;
        }
    }

    string StatusClass(string status)
    {
        if (status == "Новая") return "badge-new";
        if (status == "Подтверждена") return "badge-ok";
        if (status == "Возвращена") return "badge-done";
        return "badge-cancel";
    }
}


