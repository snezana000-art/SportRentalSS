@page "/register"
@inject RentalFacade Facade
@inject NavigationManager Nav

<PageTitle>Регистрация</PageTitle>

<h1>Регистрация</h1>

<div style="max-width: 400px">
    @if (error != "")
    {
        <div class="alert alert-danger">@error</div>
    }

    <label>Имя</label>
    <input class="form-control" type="text" @bind="name" @bind:event="oninput" />

    <label class="mt-2">Email</label>
    <input class="form-control" type="email" @bind="email" @bind:event="oninput" />

    <label class="mt-2">Пароль (не короче 6 символов)</label>
    <input class="form-control" type="password" @bind="password" @bind:event="oninput" />

    <label class="mt-2">Повторите пароль</label>
    <input class="form-control" type="password" @bind="password2" @bind:event="oninput" />

    <button class="btn btn-primary mt-3" @onclick="DoRegister">Создать аккаунт</button>
</div>

@code {
    string name = "";
    string email = "";
    string password = "";
    string password2 = "";
    string error = "";

    async Task DoRegister()
    {
        error = "";

        if (password != password2)
        {
            error = "Пароли не совпадают";
            return;
        }

        var result = await Facade.RegisterAsync(name, email, password);

        if (result == null)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            error = result;
        }
    }
}