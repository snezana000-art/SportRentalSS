@page "/register"
@inject RentalFacade Facade
@inject NavigationManager Nav

<PageTitle>Регистрация</PageTitle>

<div class="form-box">
    <h1>Регистрация</h1>

    @if (error != "")
    {
        <div class="message message-error">@error</div>
    }

    <label>Имя</label>
    <input class="field" type="text" @bind="name" @bind:event="oninput" />

    <label>Email</label>
    <input class="field" type="email" @bind="email" @bind:event="oninput" />

    <label>Пароль (не короче 6 символов)</label>
    <input class="field" type="password" @bind="password" @bind:event="oninput" />

    <label>Повторите пароль</label>
    <input class="field" type="password" @bind="password2" @bind:event="oninput" />

    <button class="button button-olive" @onclick="DoRegister">Создать аккаунт</button>

    <p class="small">Уже есть аккаунт? <a href="login">Войти</a></p>
</div>

@code {
    string name = "";
    string email = "";
    string password = "";
    string password2 = "";
    string error = "";

    async Task DoRegister()
    {
        if (password != password2)
        {
            error = "Пароли не совпадают";
            return;
        }

        var result = await Facade.RegisterAsync(name, email, password);

        if (result == null)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            error = result;
        }
    }
}