@inherits LayoutComponentBase
@inject RentalFacade Facade

<header class="topbar">
    <a class="logo" href="">Прокат<span>Спорт</span></a>
    <NavMenu />
</header>

<main class="content">
    @if (ready)
    {
        @Body
    }
    else
    {
        <p>Загрузка...</p>
    }
</main>

<footer class="footer">
    Прокат спортивного инвентаря, 2026
</footer>

<div id="blazor-error-ui">
    Произошла ошибка.
    <a href="" class="reload">Обновить</a>
    <span class="dismiss">x</span>
</div>

@code {
    bool ready = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Facade.RestoreLoginAsync();
            ready = true;
            StateHasChanged();
        }
    }
}