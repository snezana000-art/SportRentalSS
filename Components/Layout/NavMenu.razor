@implements IDisposable
@inject RentalFacade Facade
@inject NavigationManager Nav

<nav class="menu">
    <NavLink href="" Match="NavLinkMatch.All">Главная</NavLink>
    <NavLink href="catalog">Каталог</NavLink>

    @if (Facade.IsLoggedIn)
    {
        <NavLink href="cabinet">Личный кабинет</NavLink>

        @if (Facade.IsAdmin)
        {
            <NavLink href="admin">Админ-панель</NavLink>
        }

        <span class="user-name">@Facade.UserName</span>
        <button class="button button-orange button-small" @onclick="Logout">Выйти</button>
    }
    else
    {
        <NavLink href="login">Вход</NavLink>
        <NavLink href="register">Регистрация</NavLink>
    }

    <NavLink href="about">О проекте</NavLink>
</nav>

@code {
    protected override void OnInitialized()
    {
        Facade.AuthChanged += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Facade.Logout();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Facade.AuthChanged -= Refresh;
    }
}