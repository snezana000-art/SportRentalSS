<Window x:Class="MaxFlowWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Max Flow Solver" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - управление -->
        <StackPanel Grid.Column="0" Margin="10" Background="#f5f5f5">
            <TextBlock Text="Решение задачи о максимальном потоке" 
                      FontSize="16" FontWeight="Bold" Margin="0,0,0,20"
                      TextAlignment="Center"/>

            <GroupBox Header="Параметры графа" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="Количество вершин:" Margin="0,5"/>
                    <TextBox x:Name="txtVertices" Text="6" Margin="0,2,0,10"/>

                    <TextBlock Text="Исток:" Margin="0,5"/>
                    <TextBox x:Name="txtSource" Text="0" Margin="0,2,0,10"/>

                    <TextBlock Text="Сток:" Margin="0,5"/>
                    <TextBox x:Name="txtSink" Text="5" Margin="0,2,0,10"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Добавление ребра" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Из:" Width="30"/>
                        <TextBox x:Name="txtFrom" Text="0" Width="40" Margin="5,0"/>
                        <TextBlock Text="В:" Width="20" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtTo" Text="1" Width="40" Margin="5,0"/>
                    </StackPanel>

                    <TextBlock Text="Пропускная способность:" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtCapacity" Text="10" Margin="0,0,0,10"/>

                    <Button x:Name="btnAddEdge" Content="Добавить ребро" 
                           Click="BtnAddEdge_Click" Background="#4CAF50" 
                           Foreground="White" Margin="0,5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Управление">
                <StackPanel Margin="5">
                    <Button x:Name="btnCalculate" Content="Рассчитать поток" 
                           Click="BtnCalculate_Click" Background="#2196F3" 
                           Foreground="White" Margin="0,5" FontWeight="Bold"/>

                    <Button x:Name="btnClear" Content="Очистить граф" 
                           Click="BtnClear_Click" Background="#FF9800" 
                           Foreground="White" Margin="0,5"/>

                    <Button x:Name="btnLoadExample" Content="Загрузить пример" 
                           Click="BtnLoadExample_Click" Background="#9C27B0" 
                           Foreground="White" Margin="0,5"/>
                </StackPanel>
            </GroupBox>

            <!-- Список рёбер -->
            <GroupBox Header="Рёбра графа" Margin="0,10,0,0">
                <ListBox x:Name="lstEdges" Height="150" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </StackPanel>

        <!-- Правая панель - результаты и визуализация -->
        <TabControl Grid.Column="1" Margin="10">
            <TabItem Header="Результаты">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock x:Name="txtResult" FontSize="14" 
                                  TextWrapping="Wrap" Margin="0,10"/>

                        <TextBlock x:Name="txtFlowDetails" FontSize="12" 
                                  TextWrapping="Wrap" Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Матрица пропускных способностей">
                <ScrollViewer>
                    <StackPanel x:Name="matrixPanel" Margin="10"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>